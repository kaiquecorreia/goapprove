      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT DISTINCT po.order_number, po.total_amount, wf.current_level, wl.mode, u.name AS aprovador_titular FROM approval_workflow_approvers wa JOIN approval_workflow_levels wl ON wl.level_id = wa.level_id JOIN approval_workflows wf ON wf.workflow_id = wl.workflow_id JOIN purchase_orders po ON po.purchase_order_id = wf.purchase_order_id JOIN users u ON u.user_id = wa.user_id WHERE wa.status = 'PENDING' AND wf.status = 'PENDING' AND (wa.user_id IN ($aprovador) OR wa.user_id IN (SELECT user_id FROM users_substitutes WHERE substitute_id IN ($aprovador)))",
          "refId": "A"
        }
      ],
      "title": "Aprovações Pendentes por Usuário (titular + substituto)",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 },
      "id": 15,
      "panels": [],
      "title": "Regras de Negócio",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 32 },
      "id": 16,
      "options": { "cellHeight": "sm", "showHeader": true },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.name AS empresa, r.code, r.name, r.priority, r.valid_from, r.valid_to, r.conflict_strategy, rc.source_type, rc.field, rc.operator, rc.value, rc.value_to, rc.value_list, rl.level_number, rl.mode, u.name AS aprovador FROM rules r JOIN companies c ON c.company_id = r.company_id LEFT JOIN rule_conditions rc ON rc.rule_id = r.rule_id LEFT JOIN rule_levels rl ON rl.rule_id = r.rule_id LEFT JOIN rule_level_approvers rla ON rla.rule_level_id = rl.rule_level_id LEFT JOIN users u ON u.user_id = rla.user_id WHERE r.status = 'ACTIVE' AND c.name IN ($empresa) ORDER BY c.name, r.priority, rl.level_number",
          "refId": "A"
        }
      ],
      "title": "Regras Ativas (Condições e Níveis)",
      "type": "table"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisPlacement": "auto", "fillOpacity": 80, "gradientMode": "none", "lineWidth": 1, "orientation": "horizontal" }, "mappings": [] }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
      "id": 17,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" }, "xTickLabelRotation": 0 },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.code, COUNT(wf.workflow_id) AS total_ocs_aplicadas FROM approval_workflows wf JOIN rules r ON r.rule_id = wf.rule_id GROUP BY r.rule_id, r.code ORDER BY total_ocs_aplicadas DESC LIMIT 15",
          "refId": "A"
        }
      ],
      "title": "Ranking de Regras Mais Aplicadas",
      "type": "barchart"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } }, "overrides": [{ "matcher": { "id": "byName", "options": "taxa_aprovacao_pct" }, "properties": [{ "id": "unit", "value": "percent" }, { "id": "custom.cellOptions", "value": { "type": "color-background" } }] }] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
      "id": 18,
      "options": { "cellHeight": "sm", "showHeader": true, "sortBy": [{ "desc": true, "displayName": "taxa_aprovacao_pct" }] },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.code, r.name, COUNT(*) FILTER (WHERE wf.status = 'APPROVED') AS aprovadas, COUNT(*) FILTER (WHERE wf.status = 'REJECTED') AS rejeitadas, COUNT(*) FILTER (WHERE wf.status = 'PENDING') AS pendentes, ROUND(100.0 * COUNT(*) FILTER (WHERE wf.status = 'APPROVED') / NULLIF(COUNT(*) FILTER (WHERE wf.status IN ('APPROVED','REJECTED')), 0), 2) AS taxa_aprovacao_pct FROM approval_workflows wf JOIN rules r ON r.rule_id = wf.rule_id GROUP BY r.rule_id, r.code, r.name ORDER BY taxa_aprovacao_pct DESC NULLS LAST",
          "refId": "A"
        }
      ],
      "title": "Taxa de Aprovação x Rejeição por Regra",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 },
      "id": 19,
      "panels": [],
      "title": "Performance / SLA",
      "type": "row"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 49 },
      "id": 20,
      "options": { "cellHeight": "sm", "showHeader": true },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT r.code, wl.level, wl.mode, COUNT(*) AS total_niveis_concluidos, AVG(wl.completed_at - wl.started_at) AS tempo_medio, MIN(wl.completed_at - wl.started_at) AS tempo_min, MAX(wl.completed_at - wl.started_at) AS tempo_max FROM approval_workflow_levels wl JOIN approval_workflows wf ON wf.workflow_id = wl.workflow_id LEFT JOIN rules r ON r.rule_id = wf.rule_id WHERE wl.completed_at IS NOT NULL AND wl.started_at IS NOT NULL GROUP BY r.code, wl.level, wl.mode ORDER BY r.code, wl.level",
          "refId": "A"
        }
      ],
      "title": "Tempo Médio de Conclusão por Nível",
      "type": "table"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 49 },
      "id": 21,
      "options": { "cellHeight": "sm", "showHeader": true, "sortBy": [{ "desc": true, "displayName": "total_decisoes" }] },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT u.name AS aprovador, COUNT(*) AS total_decisoes, COUNT(*) FILTER (WHERE ad.decision = 'APPROVED') AS aprovadas, COUNT(*) FILTER (WHERE ad.decision = 'REJECTED') AS rejeitadas, AVG(ad.decided_at - wl.started_at) AS tempo_medio_resposta FROM approval_decisions ad JOIN approval_workflow_levels wl ON wl.level_id = ad.level_id JOIN users u ON u.user_id = ad.acting_user_id GROUP BY u.user_id, u.name ORDER BY total_decisoes DESC",
          "refId": "A"
        }
      ],
      "title": "Tempo Médio de Resposta e Volume por Aprovador",
      "type": "table"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 57 },
      "id": 22,
      "options": { "cellHeight": "sm", "showHeader": true, "sortBy": [{ "desc": true, "displayName": "tempo_no_nivel" }] },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
