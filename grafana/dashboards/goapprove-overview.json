    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "id": 12,
      "options": { "cellHeight": "sm", "showHeader": true, "sortBy": [{ "desc": false, "displayName": "started_at" }] },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT po.order_number, c.name AS empresa, po.total_amount, po.supplier_name, wf.status AS status_workflow, wf.current_level, wl.mode, u.name AS aprovador_pendente, wl.started_at FROM purchase_orders po JOIN companies c ON c.company_id = po.company_id JOIN approval_workflows wf ON wf.purchase_order_id = po.purchase_order_id JOIN approval_workflow_levels wl ON wl.workflow_id = wf.workflow_id AND wl.level = wf.current_level JOIN approval_workflow_approvers wa ON wa.level_id = wl.level_id AND wa.status = 'PENDING' JOIN users u ON u.user_id = wa.user_id WHERE wf.status = 'PENDING' AND c.name IN ($empresa) ORDER BY wl.started_at ASC",
          "refId": "A"
        }
      ],
      "title": "OCs Pendentes Agora (Nível/Aprovador Atual)",
      "type": "table"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "id": 13,
      "options": { "cellHeight": "sm", "showHeader": true, "sortBy": [{ "desc": true, "displayName": "ocs_pendentes" }] },
      "pluginVersion": "10.0.0",
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT u.name AS aprovador, COUNT(*) AS ocs_pendentes, SUM(po.total_amount) AS valor_total_pendente FROM approval_workflow_approvers wa JOIN approval_workflow_levels wl ON wl.level_id = wa.level_id JOIN approval_workflows wf ON wf.workflow_id = wl.workflow_id JOIN purchase_orders po ON po.purchase_order_id = wf.purchase_order_id JOIN users u ON u.user_id = wa.user_id WHERE wa.status = 'PENDING' AND wf.status = 'PENDING' GROUP BY u.user_id, u.name ORDER BY ocs_pendentes DESC",
          "refId": "A"
        }
      ],
      "title": "Carga de Trabalho Atual por Aprovador",
      "type": "table"
    },
    {
      "datasource": { "type": "postgres", "uid": "${DS_POSTGRES}" },
      "fieldConfig": { "defaults": { "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true } }, "overrides": [] },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "id": 14,
