generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMINISTRATOR
  APPROVER
  VIEWER
  RULES_MANAGER
  EXTERNAL_INTEGRATION
}

enum Environment {
  DEVELOPMENT
  HOMOLOGATION
  PRODUCTION
}

enum Provider {
  INFOR
}

enum AuthType {
  oauth2
}

model Company {
  companyId                  String      @id @default(uuid()) @map("company_id") @db.Uuid
  externalIntegrationCode    String      @unique @map("external_integration_code") @db.VarChar(50)
  name                       String      @map("name") @db.VarChar(150)
  cnpj                       String?     @map("cnpj") @db.VarChar(14)
  status                     Boolean     @default(true)
  externalIntegrationUrlBase String?     @map("external_integration_url_base") @db.Text
  environment                Environment @map("environment")
  notes                      String?     @map("notes") @db.Text
  createdAt                  DateTime    @default(now()) @map("created_at")
  updatedAt                  DateTime    @updatedAt @map("updated_at")

  users          CompanyUser[]
  integrations   CompanyIntegration[]
  purchaseOrders PurchaseOrder[]
  rules          Rule[]
  auditEvents    AuditEvent[]

  @@map("companies")
}

model User {
  userId                  String   @id @default(uuid()) @map("user_id") @db.Uuid
  name                    String   @map("name") @db.VarChar(150)
  email                   String   @unique @map("email") @db.VarChar(150)
  externalIntegrationUser String?  @unique @map("external_integration_user") @db.VarChar(50)
  passwordHash            String?  @map("password_hash") @db.VarChar(255)
  role                    UserRole @map("role")
  active                  Boolean  @default(true) @map("active")
  approvalLimit           Decimal? @map("approval_limit") @db.Decimal(15, 2)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  companies          CompanyUser[]
  substitutes        UserSubstitute[]           @relation("UserAsOriginal")
  substitutedBy      UserSubstitute[]           @relation("UserAsSubstitute")
  ruleLevelApprovals RuleLevelApprover[]
  workflowApprovals  ApprovalWorkflowApprover[]
  assignedDecisions  ApprovalDecision[]         @relation("DecisionAssignedUser")
  actedDecisions     ApprovalDecision[]         @relation("DecisionActingUser")
  auditedEvents      WorkflowAuditEvent[]
  auditEvents        AuditEvent[]               @relation("AuditActor")

  @@map("users")
}

model CompanyUser {
  companyId String   @map("company_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([companyId, userId])
  @@index([userId])
  @@map("companies_users")
}

model UserSubstitute {
  userId       String   @map("user_id") @db.Uuid
  substituteId String   @map("substitute_id") @db.Uuid
  priority     Int      @default(1) @map("priority")
  createdAt    DateTime @default(now()) @map("created_at")

  user       User @relation("UserAsOriginal", fields: [userId], references: [userId], onDelete: Cascade)
  substitute User @relation("UserAsSubstitute", fields: [substituteId], references: [userId], onDelete: Cascade)

  @@id([userId, substituteId])
  @@map("users_substitutes")
}

model PurchaseOrder {
  purchaseOrderId String @id @default(uuid()) @map("purchase_order_id") @db.Uuid
  companyId       String @map("company_id") @db.Uuid

  sourceSystem  String   @map("source_system") @db.VarChar(50)
  eventType     String   @map("event_type") @db.VarChar(100)
  schemaVersion String   @map("schema_version") @db.VarChar(20)
  sentAt        DateTime @map("sent_at")

  orderNumber      String              @map("order_number") @db.VarChar(50)
  revision         Int                 @map("revision")
  orderType        String              @map("order_type") @db.VarChar(50)
  statusLn         String              @map("status_ln") @db.VarChar(50)
  erpCreatedAt     DateTime            @map("erp_created_at")
  buyerCode        String?             @map("buyer_code") @db.VarChar(50)
  buyerName        String?             @map("buyer_name") @db.VarChar(150)
  requesterCode    String?             @map("requester_code") @db.VarChar(50)
  requesterName    String?             @map("requester_name") @db.VarChar(150)
  supplierCode     String?             @map("supplier_code") @db.VarChar(50)
  supplierName     String?             @map("supplier_name") @db.VarChar(150)
  currency         String?             @map("currency") @db.VarChar(10)
  totalAmount      Decimal             @map("total_amount") @db.Decimal(15, 2)
  paymentTerms     String?             @map("payment_terms") @db.VarChar(50)
  costCenter       String?             @map("cost_center") @db.VarChar(50)
  department       String?             @map("department") @db.VarChar(150)
  projectCode      String?             @map("project_code") @db.VarChar(50)
  warehouse        String?             @map("warehouse") @db.VarChar(50)
  additionalFields Json?               @map("additional_fields")
  status           PurchaseOrderStatus @default(PENDING) @map("status")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company  Company             @relation(fields: [companyId], references: [companyId], onDelete: Cascade)
  lines    PurchaseOrderLine[]
  workflow ApprovalWorkflow?

  @@index([companyId, orderNumber])
  @@index([companyId, erpCreatedAt])
  @@index([companyId, status, erpCreatedAt])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  purchaseOrderLineId String @id @default(uuid()) @map("purchase_order_line_id") @db.Uuid
  purchaseOrderId     String @map("purchase_order_id") @db.Uuid

  lineNumber      Int       @map("line_number")
  itemCode        String    @map("item_code") @db.VarChar(50)
  itemDescription String    @map("item_description") @db.VarChar(255)
  quantity        Decimal   @map("quantity") @db.Decimal(15, 4)
  unitOfMeasure   String    @map("unit_of_measure") @db.VarChar(10)
  unitPrice       Decimal   @map("unit_price") @db.Decimal(15, 4)
  lineAmount      Decimal   @map("line_amount") @db.Decimal(15, 2)
  costCenter      String?   @map("cost_center") @db.VarChar(50)
  category        String?   @map("category") @db.VarChar(100)
  deliveryDate    DateTime? @map("delivery_date") @db.Date

  createdAt DateTime @default(now()) @map("created_at")

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [purchaseOrderId], onDelete: Cascade)

  @@unique([purchaseOrderId, lineNumber])
  @@map("purchase_order_lines")
}

model CompanyIntegration {
  integrationId String   @id @default(uuid()) @map("integration_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  provider      Provider @map("provider")
  authType      AuthType @default(oauth2) @map("auth_type")
  baseUrl       String   @map("base_url") @db.Text
  clientId      String?  @map("client_id") @db.VarChar(255)
  clientSecret  String?  @map("client_secret") @db.Text
  customData    Json?    @map("custom_data")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [companyId], onDelete: Cascade)

  @@unique([companyId, provider])
  @@map("company_integrations")
}

enum RuleStatus {
  ACTIVE
  INACTIVE
}

enum RuleType {
  STANDARD
  AUTO_APPROVE
}

enum ApprovalMode {
  ANY
  ALL
  SEQUENTIAL
}

enum RuleConflictStrategy {
  HIGHEST_PRIORITY
  MOST_RESTRICTIVE
  FIRST_MATCH
}

enum RuleConditionSourceType {
  PO_HEADER
  PO_LINE
  PO_ADDITIONAL
  MANUAL_FIELD
}

enum RuleOperator {
  EQUALS
  NOT_EQUALS
  GREATER_THAN
  GREATER_THAN_OR_EQUAL
  LESS_THAN
  LESS_THAN_OR_EQUAL
  BETWEEN
  CONTAINS
  IN_LIST
  NOT_IN_LIST
  EXISTS
  NOT_EXISTS
}

model Rule {
  ruleId           String               @id @default(uuid()) @map("rule_id") @db.Uuid
  code             String               @unique @map("code") @db.VarChar(50)
  name             String               @map("name") @db.VarChar(150)
  description      String?              @map("description") @db.Text
  companyId        String               @map("company_id") @db.Uuid
  priority         Int                  @map("priority")
  validFrom        DateTime             @map("valid_from") @db.Date
  validTo          DateTime?            @map("valid_to") @db.Date
  status           RuleStatus           @default(ACTIVE) @map("status")
  ruleType         RuleType             @default(STANDARD) @map("rule_type")
  conflictStrategy RuleConflictStrategy @default(HIGHEST_PRIORITY) @map("conflict_strategy")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  company    Company            @relation(fields: [companyId], references: [companyId], onDelete: Restrict)
  conditions RuleCondition[]
  levels     RuleLevel[]
  workflows  ApprovalWorkflow[]

  @@index([companyId, status])
  @@index([companyId, priority])
  @@map("rules")
}

model RuleCondition {
  ruleConditionId String                  @id @default(uuid()) @map("rule_condition_id") @db.Uuid
  ruleId          String                  @map("rule_id") @db.Uuid
  sourceType      RuleConditionSourceType @map("source_type")
  field           String                  @map("field") @db.VarChar(100)
  operator        RuleOperator            @map("operator")
  value           String?                 @map("value") @db.Text
  valueTo         String?                 @map("value_to") @db.Text
  valueList       Json?                   @map("value_list")
  createdAt       DateTime                @default(now()) @map("created_at")

  rule Rule @relation(fields: [ruleId], references: [ruleId], onDelete: Cascade)

  @@index([ruleId])
  @@map("rule_conditions")
}

model RuleLevel {
  ruleLevelId String       @id @default(uuid()) @map("rule_level_id") @db.Uuid
  ruleId      String       @map("rule_id") @db.Uuid
  levelNumber Int          @map("level_number")
  mode        ApprovalMode @map("mode")
  createdAt   DateTime     @default(now()) @map("created_at")

  rule      Rule                @relation(fields: [ruleId], references: [ruleId], onDelete: Cascade)
  approvers RuleLevelApprover[]

  @@unique([ruleId, levelNumber])
  @@map("rule_levels")
}

model RuleLevelApprover {
  ruleLevelId String   @map("rule_level_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  ruleLevel RuleLevel @relation(fields: [ruleLevelId], references: [ruleLevelId], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@id([ruleLevelId, userId])
  @@map("rule_level_approvers")
}

enum PurchaseOrderStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  NO_RULE
  ERROR
}

enum WorkflowStatus {
  PENDING
  APPROVED
  REJECTED
  NO_RULE
  CANCELLED
}

enum LevelStatus {
  LOCKED
  PENDING
  APPROVED
  REJECTED
  SKIPPED
}

enum DecisionType {
  APPROVED
  REJECTED
}

enum LnSyncStatus {
  NOT_APPLICABLE
  PENDING
  SYNCED
  FAILED
}

model ApprovalWorkflow {
  workflowId              String         @id @default(uuid()) @map("workflow_id") @db.Uuid
  purchaseOrderId         String         @unique @map("purchase_order_id") @db.Uuid
  ruleId                  String?        @map("rule_id") @db.Uuid
  status                  WorkflowStatus @default(PENDING) @map("status")
  currentLevel            Int?           @map("current_level")
  requireCommentOnApprove Boolean        @default(false) @map("require_comment_on_approve")
  requireCommentOnReject  Boolean        @default(true) @map("require_comment_on_reject")
  onRejectAction          String         @default("HALT") @map("on_reject_action") @db.VarChar(20)
  finalizedAt             DateTime?      @map("finalized_at")
  lnSyncStatus            LnSyncStatus   @default(NOT_APPLICABLE) @map("ln_sync_status")
  lnSyncAttempts          Int            @default(0) @map("ln_sync_attempts")
  lnLastError             String?        @map("ln_last_error") @db.Text
  lnSyncedAt              DateTime?      @map("ln_synced_at")
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  purchaseOrder PurchaseOrder           @relation(fields: [purchaseOrderId], references: [purchaseOrderId], onDelete: Cascade)
  rule          Rule?                   @relation(fields: [ruleId], references: [ruleId], onDelete: SetNull)
  levels        ApprovalWorkflowLevel[]
  auditEvents   WorkflowAuditEvent[]

  @@index([status])
  @@index([status, finalizedAt(sort: Desc)])
  @@map("approval_workflows")
}

model ApprovalWorkflowLevel {
  levelId     String       @id @default(uuid()) @map("level_id") @db.Uuid
  workflowId  String       @map("workflow_id") @db.Uuid
  level       Int          @map("level")
  mode        ApprovalMode @map("mode")
  status      LevelStatus  @default(LOCKED) @map("status")
  startedAt   DateTime?    @map("started_at")
  completedAt DateTime?    @map("completed_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  workflow  ApprovalWorkflow           @relation(fields: [workflowId], references: [workflowId], onDelete: Cascade)
  approvers ApprovalWorkflowApprover[]
  decisions ApprovalDecision[]

  @@unique([workflowId, level])
  @@index([workflowId, status])
  @@map("approval_workflow_levels")
}

model ApprovalWorkflowApprover {
  levelId       String      @map("level_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  sequenceOrder Int         @default(1) @map("sequence_order")
  status        LevelStatus @default(PENDING) @map("status")
  decidedAt     DateTime?   @map("decided_at")

  level ApprovalWorkflowLevel @relation(fields: [levelId], references: [levelId], onDelete: Cascade)
  user  User                  @relation(fields: [userId], references: [userId], onDelete: Restrict)

  @@id([levelId, userId])
  @@unique([levelId, sequenceOrder])
  @@index([userId, status])
  @@map("approval_workflow_approvers")
}

model ApprovalDecision {
  decisionId     String       @id @default(uuid()) @map("decision_id") @db.Uuid
  levelId        String       @map("level_id") @db.Uuid
  assignedUserId String       @map("assigned_user_id") @db.Uuid
  actingUserId   String       @map("acting_user_id") @db.Uuid
  decision       DecisionType @map("decision")
  comment        String?      @map("comment") @db.Text
  decidedAt      DateTime     @default(now()) @map("decided_at")

  level        ApprovalWorkflowLevel @relation(fields: [levelId], references: [levelId], onDelete: Cascade)
  assignedUser User                  @relation("DecisionAssignedUser", fields: [assignedUserId], references: [userId], onDelete: Restrict)
  actingUser   User                  @relation("DecisionActingUser", fields: [actingUserId], references: [userId], onDelete: Restrict)

  @@map("approval_decisions")
}

model WorkflowAuditEvent {
  eventId     String   @id @default(uuid()) @map("event_id") @db.Uuid
  workflowId  String   @map("workflow_id") @db.Uuid
  type        String   @map("type") @db.VarChar(50)
  severity    String   @map("severity") @db.VarChar(20)
  actorUserId String?  @map("actor_user_id") @db.Uuid
  message     String   @map("message") @db.Text
  metadata    Json?    @map("metadata")
  createdAt   DateTime @default(now()) @map("created_at")

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [workflowId], onDelete: Cascade)
  actor    User?            @relation(fields: [actorUserId], references: [userId], onDelete: SetNull)

  @@index([workflowId, createdAt])
  @@map("workflow_audit_events")
}

// Generic, append-only audit trail covering every entity in the system.
// Replaces WorkflowAuditEvent, which could only describe approval workflows.
model AuditEvent {
  // uuid(7) is time-ordered, so inserts stay sequential in the btree instead
  // of scattering across pages the way random uuid(4) would.
  auditEventId String   @id @default(uuid(7)) @map("audit_event_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  // What happened
  action   String  @map("action") @db.VarChar(60) // "rule.update", "workflow.decision_recorded"
  entity   String  @map("entity") @db.VarChar(60)
  // Polymorphic on purpose: no FK, so the trail survives the entity's deletion.
  entityId String? @map("entity_id") @db.VarChar(100)
  // Lowercase string rather than an enum: the web timeline casts this straight
  // into TimelineEvent['type'] (see purchaseOrderDetailClient.ts#toTimeline).
  severity String  @default("info") @map("severity") @db.VarChar(20)
  message  String? @map("message") @db.Text

  // Who did it
  companyId   String? @map("company_id") @db.Uuid
  actorUserId String? @map("actor_user_id") @db.Uuid
  actorType   String  @default("SYSTEM") @map("actor_type") @db.VarChar(20) // USER | INTEGRATION | SYSTEM
  // Immutable snapshot, so a deleted user still leaves a named actor behind.
  actorLabel  String? @map("actor_label") @db.VarChar(150)

  // Where it came from
  correlationId String? @map("correlation_id") @db.Uuid
  // VarChar, not inet: a malformed X-Forwarded-For must never fail the insert.
  ip            String? @map("ip") @db.VarChar(45)
  userAgent     String? @map("user_agent") @db.VarChar(512)
  httpMethod    String? @map("http_method") @db.VarChar(10)
  httpPath      String? @map("http_path") @db.VarChar(255)

  // What changed
  metadata Json? @map("metadata")
  before   Json? @map("before")
  after    Json? @map("after")

  company Company? @relation(fields: [companyId], references: [companyId], onDelete: Restrict)
  actor   User?    @relation("AuditActor", fields: [actorUserId], references: [userId], onDelete: SetNull)

  @@index([companyId, createdAt(sort: Desc)])
  @@index([entity, entityId, createdAt])
  @@index([companyId, action, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([correlationId])
  @@map("audit_events")
}
